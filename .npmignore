# Supplement package.json.files with exclusions for local generated state.
**/__pycache__/
**/*.pyc
experiments/
.test-output/
# Runtime data and authentication are not distributable package resources.
**/*.sqlite3*
**/api-token.txt
**/endpoint.json
**/*.log
node_modules/
.git/

# Per-project connection references and local encrypted Agent secrets.
**/credentials/
**/*.secret
**/.workbench/
