{
  "name": "@chanhaoxian5/dsh-workbench",
  "version": "0.2.0",
  "private": true,
  "description": "Local Workbench: bundled UI/backend, DSH lifecycle settings and stdio MCP",
  "type": "module",
  "main": "./lib/index.mjs",
  "exports": {".": "./lib/index.mjs", "./client": "./lib/client.js", "./cordis.patch.yml": "./cordis.patch.yml", "./package.json": "./package.json"},
  "dsh": {"bundle": {"patch": "./cordis.patch.yml"}, "client": {"inject": ["@deepseek-ai/dsh-api-remotes", "@deepseek-ai/dsh-client-ui-settings-general"], "platform": "web"}},
  "peerDependencies": {"@deepseek-ai/dsh-tools": "0.2.1-rc.5", "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.5", "@deepseek-ai/schemastery": "~3.18.5"},
  "files": ["lib/", "backend/workbench/*.py", "backend/workbench/web/", "python/workbench/*.py", "scripts/*.py", "scripts/*.mjs", "scripts/*.ps1", "docs/", "cordis.patch.yml", "README.md", "bundle-manifest.json"],
  "scripts": {"test": "node --test tests/*.test.mjs"},
  "repository": {"type": "git", "url": "https://github.com/chanhaoxian5-ship-it/dsh-workbench.git"},
  "engines": {"node": ">=22"}
}
